  "settings": [
    {
      "setting": "Cross-validation folds k",
      "default": "5",
      "allowed_range": "2\u201310",
      "step": "1",
      "effect": "Class-count requirement and Class support fold term."
    },
    {
      "setting": "Structural: sample-support target N",
      "default": "20",
      "allowed_range": "5\u2013100",
      "step": "1",
      "effect": "Structural item and mean; not CV count support."
    },
    {
      "setting": "Low-information: frequency ratio R",
      "default": "19",
      "allowed_range": "5\u201399",
      "step": "1",
      "effect": "Flag when ratio > R and distinct percentage \u2264 U; also changes redundancy eligibility."
    },
    {
      "setting": "Low-information: distinct-value percentage U",
      "default": "10",
      "allowed_range": "1\u201325",
      "step": "1",
      "effect": "Flag when percentage \u2264 U and ratio > R; also changes redundancy eligibility."
    },
    {
      "setting": "Low-variation caution: CV (%)",
      "default": "1",
      "allowed_range": "0.1\u20135",
      "step": "0.1",
      "effect": "Informational only; strictly below the threshold."
    },
    {
      "setting": "Redundancy: absolute correlation c",
      "default": "0.9",
      "allowed_range": "0.8\u20130.99",
      "step": "0.01",
      "effect": "Evaluated pairs above c, with 1e\u22125 equality tolerance."
    },
    {
      "setting": "QC reproducibility: RSD (%)",
      "default": "20",
      "allowed_range": "10\u201340",
      "step": "1",
      "effect": "Informational pass counts; detection must still be >70%."
    },
    {
      "setting": "Outliers: fence multiplier a",
      "default": "1.5",
      "allowed_range": "1\u20133",
      "step": "0.1",
      "effect": "Sample medians outside Q1\u2212a\u00b7IQR / Q3+a\u00b7IQR."
    },
    {
      "setting": "Extreme-alert percentile",
      "default": "2.5",
      "allowed_range": "2.5\u201310",
      "step": "2.5",
      "effect": "Choose 2.5, 5, 7.5 or 10 from R1."
    },
    {
      "setting": "Low-alert percentile",
      "default": "10",
      "allowed_range": "2.5\u201310",
      "step": "2.5",
      "effect": "Choose 2.5, 5, 7.5 or 10; effective value never below extreme."
    },
    {
      "setting": "Separability: neighbours K",
      "default": "7",
      "allowed_range": "3\u201315",
      "step": "1",
      "effect": "Neighbour count, not CV folds."
    },
    {
      "setting": "Separability: overlap threshold \u03b8",
      "default": "3",
      "allowed_range": "0\u20137",
      "step": "1",
      "effect": "Integer; effective maximum floor(K/2), although input maximum is 7."
    },
    {
      "setting": "Feature associations: FDR q",
      "default": "0.05",
      "allowed_range": "0.01\u20130.2",
      "step": "0.01",
      "effect": "Significance and paired-test minimum support."
    }
  ],
  "custom_alert_cutoffs": {
    "checks": [
      "Missing entries and zeros",
      "Low-information features",
      "Redundant features",
      "Outlier samples"
    ],
    "tiers": [
      "Extreme",
      "Low"
    ],
    "fields": 8,
    "allowed_range": "0\u2013100",
    "default": "Empty: use the selected reference percentile"
  }
