.vercel
.env*.local

# Local data/cache artifacts should not be committed to the source repository.
# The public Docker image is thin and must not bundle these local cache/source
# directories either; it reads hosted MERIT assessment artifacts at runtime.
merit-cache-workbench-full-v*/
mw-dump-latest-confirmation*/
metabolights_data/
outputs/
*.tar
*.tar.gz
*.zip

# v2 live downloads, generated calculations and private release reports
/docker/merit-v2/runtime/runs/
/release-artifacts/
__pycache__/
*.pyc
# Runtime source under historical-looking output folder names is code, not generated results.
!docker/merit-v2/runtime/source_snapshot/outputs/
!docker/merit-v2/runtime/source_snapshot/outputs/**

# Never publish server authentication artifacts.
**/.env
**/credentials.env*
**/config.env
**/server_only_*/
**/yes
**/yes.pub
**/id_rsa*
**/id_ed25519*
**/*.pem
**/*.key
