# Copy to: deploy/config.env
#
# Root project directory (where vercel.json lives)
PROJECT_ROOT=/home/shayantan/metabolomics/ML-ready
#
# Precomputed cache folder to publish
CACHE_ROOT=/home/shayantan/metabolomics/ML-ready/merit-cache-workbench-full-v6
#
# Cloudflare R2 S3 endpoint and bucket
R2_ENDPOINT=https://147880730eec94d25798cfb573c28bf1.r2.cloudflarestorage.com
R2_BUCKET=merit-cache
#
# Public R2 domain (for Vercel MERIT_PRECOMPUTED_ROOT)
R2_PUBLIC_ROOT=https://pub-acf151eb41e04ee795a86a8049d54039.r2.dev
#
# Prefix inside bucket. You can set this in the script via --r2-prefix too.
R2_PREFIX=merit-cache/v6
#
# Vercel config
VERCEL_ENV=production
MERIT_CACHE_ONLY=1
#
# Local writable cache for vercel CLI in restricted environments
XDG_CACHE_HOME=/home/shayantan/metabolomics/ML-ready/.cache
#
# Cloudflare Web Analytics (MERIT-ML dashboard is already wired in code).
# Dashboard: https://dash.cloudflare.com/147880730eec94d25798cfb573c28bf1/dashboards/507733aa-714f-4278-9352-f5b9a996d0a4
CLOUDFLARE_ACCOUNT_ID=147880730eec94d25798cfb573c28bf1
CLOUDFLARE_WEB_ANALYTICS_SITE_ID=507733aa-714f-4278-9352-f5b9a996d0a4
CLOUDFLARE_WEB_ANALYTICS_DASHBOARD_URL=https://dash.cloudflare.com/147880730eec94d25798cfb573c28bf1/dashboards/507733aa-714f-4278-9352-f5b9a996d0a4
MERIT_VISIT_STATS_PROVIDER=cloudflare
#
# Optional: Umami API key for About-page visitor totals (server-side only).
# Set UMAMI_API_KEY in deploy/credentials.env; deploy.sh syncs it to Vercel when present.
# Recommended: Cloudflare Web Analytics (free). Set CLOUDFLARE_API_TOKEN in credentials.env.
# Local preview: MERIT_VISIT_STATS_MODE=mock python3 -m flask --app api.index:app run --port 8774

